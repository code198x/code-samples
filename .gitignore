# Build outputs
build/
*.prg
*.o
*.bin
*.d64
*.t64
*.tap
*.out

# Amiga executables (no extension) - explicit names
commodore-amiga/**/signal
commodore-amiga/**/hop
commodore-amiga/patterns/assembly/audio/playing-a-sample/demo
commodore-amiga/patterns/assembly/audio/playing-a-sample/demo.adf

# Emulator and capture outputs
*.vsf
*.vfl
*.sna
*.sym
vice.log
**/capture/artefacts/

# OS files
.DS_Store
Thumbs.db

# Python bytecode from the capture tools
__pycache__/
*.pyc

# Editor files
*.swp
*~
.vscode/
.idea/

# Temporary files
*.tmp
*.bak

# Retained bitmap memory readbacks are verification evidence, not ROM builds.
!**/patterns/assembly/rendering/tile-region/verification/*.bin

# Character-span destination readbacks (not executable/firmware images).
!**/patterns/assembly/rendering/fixed-characters/verification/*.bin
