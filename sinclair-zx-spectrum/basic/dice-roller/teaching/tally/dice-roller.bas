10 BORDER 0: PAPER 0: INK 7: BRIGHT 0: CLS
20 RANDOMIZE: DIM t(6)
30 LET n=0: LET b=12
440 FOR i=1 TO b
450 LET d=INT (RND*6)+1: LET t(d)=t(d)+1: LET n=n+1
460 PRINT i;": ";d
490 NEXT i
600 GO SUB 1000: GO SUB 1100
750 STOP
1000 CLS: PRINT AT 0,9; INK 5; BRIGHT 1; "DICE ROLLER"
1030 PRINT AT 4,1; INK 5; "FACE  COUNT"
1040 FOR j=1 TO 6: LET row=5+2*(j-1)
1050 PRINT AT row,2;j
1080 NEXT j
1090 RETURN
1100 PRINT AT 1,1; "Rolls ";n;"   "
1110 FOR j=1 TO 6
1120 LET row=5+2*(j-1)
1130 PRINT AT row,7;t(j);"    "
1160 NEXT j
1180 RETURN
