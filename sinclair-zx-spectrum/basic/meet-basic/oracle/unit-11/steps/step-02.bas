5 RANDOMIZE
10 PAPER 0
20 INK 7
30 BORDER 0
40 CLS
50 GO SUB 500
60 INPUT "Ask a question: ";q$
70 LET answer=INT (RND*3)+1
80 CLS
81 FOR i=1 TO 3
82 PRINT ".";
83 PAUSE 10
84 NEXT i
85 BEEP 0.05,0
88 PRINT
89 GO SUB 500
92 PRINT "THE STONE SAYS"
95 INK 6
100 IF answer=1 THEN PRINT "Try a small experiment."
110 IF answer=2 THEN PRINT "Ask someone to join you."
120 IF answer=3 THEN PRINT "Take a different route."
130 INK 7
140 STOP
500 PRINT "ORACLE STONE"
510 PRINT "------------"
520 PRINT
530 RETURN
