290 GO TO 1000
1000 PRINT AT 18,0;"Release the keys.              "
1010 PRINT AT 20,0;"1-4 choose. Hold q to quit."
1020 GO SUB 1600
1030 PRINT AT 18,0;"YOUR TURN                     "
1040 GO SUB 1500
1050 GO SUB 900
1060 GO SUB 1600
1070 PRINT AT 18,0;"You chose ";k$;"                   "
1080 STOP
1500 LET k$=INKEY$
1510 IF k$="" THEN GO TO 1500
1520 IF k$="q" THEN GO TO 1900
1530 IF k$<"1" THEN GO TO 1580
1540 IF k$>"4" THEN GO TO 1580
1550 LET p=VAL k$
1560 RETURN
1580 GO SUB 1600
1590 GO TO 1500
1600 LET a$=INKEY$
1610 IF a$="q" THEN GO TO 1900
1620 IF a$<>"" THEN GO TO 1600
1630 RETURN
