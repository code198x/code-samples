: SHOW CLS ." TURN " DUP U.
." TIMER " DA @ U. ;
: DTOGGLE DA @ IF 0 DA ! 0 DR !
ELSE DSTART THEN ;
: TURNS DCLOCK DINIT 0 KP ! 0 SHOW
BEGIN DSERVICE FKEY SWAP
IF DROP 1+ DSTART SHOW
ELSE DUP 48 = IF DROP DROP EXIT THEN
DUP 50 = IF DROP DTOGGLE SHOW
ELSE 49 = IF 1+ DA @ IF DSTART THEN
SHOW THEN THEN THEN 0 UNTIL ;
