5000 REM PARSE A$: S STATUS, V VERB, N NOUN
5010 S=0: V=0: N=0: W$="": O$=""
5020 IF PR<>1 THEN S=9: RETURN
5030 LL=LEN(A$): IF LL>63 THEN S=2: RETURN
5035 IF LL=0 THEN S=1: RETURN
5040 REM CHECK THE ENTIRE INPUT BEFORE LOOKING UP WORDS
5050 FOR P=1 TO LL
5060 TC=ASC(MID$(A$,P,1)): IF TC>=193 AND TC<=218 THEN TC=TC-128
5070 IF TC<>32 AND (TC<48 OR TC>90 OR (TC>57 AND TC<65)) THEN S=3: RETURN
5080 NEXT P
5090 WC=0: P=1
5100 IF P>LL THEN GOTO 5230
5110 IF MID$(A$,P,1)=" " THEN P=P+1: GOTO 5100
5120 WC=WC+1: IF WC>2 THEN S=4: RETURN
5130 T$=""
5140 IF P>LL THEN GOTO 5190
5150 IF MID$(A$,P,1)=" " THEN GOTO 5190
5160 TC=ASC(MID$(A$,P,1)): IF TC>=193 AND TC<=218 THEN TC=TC-128
5170 T$=T$+CHR$(TC): P=P+1
5180 GOTO 5140
5190 IF WC=1 THEN W$=T$
5200 IF WC=2 THEN O$=T$
5210 GOTO 5100
5230 IF WC=0 THEN S=1: RETURN
5240 IV=0: F=0: IF LEN(W$)>12 THEN S=5: RETURN
5250 FOR I=1 TO NV
5260 IF W$=D$(I) THEN IV=U(I): F=R(I)
5270 NEXT I
5280 IF IV=0 THEN S=5: RETURN
5290 IF WC=1 AND F=1 THEN S=7: RETURN
5300 IF WC=2 AND F=0 THEN S=8: RETURN
5310 NI=0: IF WC=1 THEN GOTO 5360
5315 IF LEN(O$)>12 THEN S=6: RETURN
5317 IF NN=0 THEN GOTO 5350
5320 FOR I=1 TO NN
5330 IF O$=E$(I) THEN NI=Z(I)
5340 NEXT I
5350 IF NI=0 THEN S=6: RETURN
5360 V=IV: N=NI: RETURN
6000 REM INIT ONCE FROM CALLER DATA CURSOR
6010 PR=0: S=10: READ NV,NN
6020 IF NV<1 OR NV>32 OR NV<>INT(NV) OR NN<0 OR NN>32 OR NN<>INT(NN) THEN RETURN
6030 DIM D$(NV): DIM U(NV): DIM R(NV)
6040 DIM E$(NN+1): DIM Z(NN+1)
6050 FOR I=1 TO NV
6060 READ T$,KK,JJ: GOSUB 6500: IF OK=0 THEN RETURN
6070 IF KK<1 OR KK>255 OR KK<>INT(KK) OR JJ<0 OR JJ>2 OR JJ<>INT(JJ) THEN RETURN
6075 IF I=1 THEN GOTO 6120
6080 FOR B=1 TO I-1
6090 IF T$=D$(B) THEN RETURN
6100 IF KK=U(B) AND JJ<>R(B) THEN RETURN
6110 NEXT B
6120 D$(I)=T$: U(I)=KK: R(I)=JJ
6130 NEXT I
6135 IF NN=0 THEN GOTO 6220
6140 FOR I=1 TO NN
6150 READ T$,KK: GOSUB 6500: IF OK=0 THEN RETURN
6160 IF KK<1 OR KK>255 OR KK<>INT(KK) THEN RETURN
6165 IF I=1 THEN GOTO 6200
6170 FOR B=1 TO I-1
6180 IF T$=E$(B) THEN RETURN
6190 NEXT B
6200 E$(I)=T$: Z(I)=KK
6210 NEXT I
6220 PR=1: S=0: RETURN
6500 REM A DICTIONARY WORD IS1..12 UPPERCASE LETTERS/DIGITS
6510 OK=0: IF LEN(T$)<1 OR LEN(T$)>12 THEN RETURN
6520 FOR Q=1 TO LEN(T$)
6530 TC=ASC(MID$(T$,Q,1))
6540 IF TC<48 OR TC>90 OR (TC>57 AND TC<65) THEN RETURN
6550 NEXT Q
6560 OK=1: RETURN
