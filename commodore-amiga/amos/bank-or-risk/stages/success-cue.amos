Hide
Curs Off
Palette $000,$FFF
Paper 0
Pen 1
Play Off
Wave 1 To 15
Volume 24
Set Envel 1,0 To 1,63
Set Envel 1,1 To 9,0
Set Envel 1,2 To 1,0
Set Envel 1,3 To 1,0
Set Envel 1,4 To 1,0
Set Envel 1,5 To 1,0
Set Envel 1,6 To 1,0
BR_CAP=10
BR_GOAL=30
BR_MAXTURN=5
BR_LASTSC=-1
BR_APPQUIT=0
Cls 0
Locate 1,2
Print "BANK OR RISK"
Locate 1,5
Print "Secure 30 points in five rounds."
Print "Roll 1-6. Over 10 loses the round."
Print "Exactly 10 banks automatically."
Locate 1,10
Print "SPACE starts. Q returns to editor."
Repeat
   Gosub BR_READ_FRESH
Until BR_K$=" " Or BR_K$="Q"
If BR_K$="Q" Then BR_APPQUIT=-1
Randomize Timer
While BR_APPQUIT=0
   Play Off
   BR_BANKED=0
   For BR_TURNNO=1 To BR_MAXTURN
      BR_TOTAL=0
      BR_LASTROLL=0
      BR_AWARD=0
      BR_HANDFIN=0
      BR_SESSIONFIN=0
      BR_MSG$="Roll once before you can bank."
      Repeat
         Gosub BR_DRAW_STATE
         Gosub BR_READ_FRESH
         If BR_K$="Q"
            BR_APPQUIT=-1
            Exit
         End If
         If BR_K$="R"
            BR_FACE=Rnd(5)+1
            BR_LASTROLL=BR_FACE
            BR_TOTAL=BR_TOTAL+BR_FACE
            BR_MSG$="Bank it or risk another roll?"
            If BR_TOTAL>BR_CAP
               BR_AWARD=0
               BR_HANDFIN=-1
               BR_MSG$="Bust! This round secures zero."
            Else
               If BR_TOTAL=BR_CAP
                  BR_AWARD=BR_TOTAL
                  BR_HANDFIN=-1
                  BR_MSG$="Perfect 10. Secured automatically."
               End If
            End If
         End If
         If BR_K$="B"
            If BR_TOTAL>0
               BR_AWARD=BR_TOTAL
               BR_HANDFIN=-1
               BR_MSG$="Banked. These points are safe."
            Else
               BR_MSG$="Roll once before you can bank."
            End If
         End If
      Until BR_HANDFIN
      If BR_APPQUIT Then Exit
      BR_BANKED=BR_BANKED+BR_AWARD
      BR_REMAIN=BR_MAXTURN-BR_TURNNO
      If BR_BANKED>=BR_GOAL
         BR_SESSIONFIN=1
         BR_MSG$="Target reached. You made it!"
      Else
         If BR_BANKED+BR_CAP*BR_REMAIN<BR_GOAL
            BR_SESSIONFIN=-1
            BR_MSG$="Target out of reach this time."
         End If
      End If
      Gosub BR_SOUND_RESULT
      If BR_SESSIONFIN<>0 Then Exit
      Gosub BR_DRAW_STATE
      Repeat
         Gosub BR_READ_FRESH
         If BR_K$="Q" Then BR_APPQUIT=-1
      Until BR_K$=" " Or BR_APPQUIT
      If BR_APPQUIT Then Exit
   Next BR_TURNNO
   If BR_APPQUIT Then Exit
   Gosub BR_DRAW_STATE
   Repeat
      Gosub BR_READ_FRESH
      If BR_K$="Q" Then BR_APPQUIT=-1
   Until BR_K$="A" Or BR_APPQUIT
Wend
Play Off
Show
End

BR_DRAW_STATE:
Cls 0
Ink 1
Locate 1,1
Print "BANK OR RISK"
Box 0,16 To 223,55
Locate 1,3
Print "Secured: ";BR_BANKED;"  Target: ";BR_GOAL
Locate 1,5
Print "Round ";BR_TURNNO;" of ";BR_MAXTURN
Ink 1
Box 0,64 To 223,111
Locate 1,9
Print "Round total: ";BR_TOTAL
Locate 1,11
Print "Limit: ";BR_CAP
Locate 1,12
If BR_HANDFIN
   Print "This round secured: ";BR_AWARD
Else
   Print "At risk until you bank."
End If
Locate 29,4
Print "Last roll"
Locate 31,13
Print BR_LASTROLL
Gosub BR_DRAW_DIE
Locate 1,15
If BR_SESSIONFIN<>0
   Print "Unused rounds: ";BR_MAXTURN-BR_TURNNO
Else
   Print "Rounds after this: ";BR_MAXTURN-BR_TURNNO
End If
Box 0,128 To 319,151
Locate 1,17
Print BR_MSG$
Box 0,160 To 319,183
Locate 1,21
If BR_SESSIONFIN<>0
   Print "A new challenge   Q quit"
Else
   If BR_HANDFIN
      Print "SPACE next round  Q quit"
   Else
      Print "R roll   B bank   Q quit"
   End If
End If
Return

BR_READ_FRESH:
If BR_LASTSC>=0
   Repeat
      Wait Vbl
   Until Key State(BR_LASTSC)=0
End If
Clear Key
Repeat
   BR_K$=Upper$(Inkey$)
   Wait Vbl
Until BR_K$<>""
BR_LASTSC=Scancode
Return

BR_DRAW_DIE:
Ink 0
Bar 240,48 To 288,96
Ink 1
Box 240,48 To 288,96
If BR_LASTROLL=1
   Bar 262,70 To 266,74
End If
If BR_LASTROLL=2
   Bar 248,56 To 252,60
   Bar 276,84 To 280,88
End If
If BR_LASTROLL=3
   Bar 248,56 To 252,60
   Bar 262,70 To 266,74
   Bar 276,84 To 280,88
End If
If BR_LASTROLL=4
   Bar 248,56 To 252,60
   Bar 276,56 To 280,60
   Bar 248,84 To 252,88
   Bar 276,84 To 280,88
End If
If BR_LASTROLL=5
   Bar 248,56 To 252,60
   Bar 276,56 To 280,60
   Bar 262,70 To 266,74
   Bar 248,84 To 252,88
   Bar 276,84 To 280,88
End If
If BR_LASTROLL=6
   Bar 248,56 To 252,60
   Bar 276,56 To 280,60
   Bar 248,70 To 252,74
   Bar 276,70 To 280,74
   Bar 248,84 To 252,88
   Bar 276,84 To 280,88
End If
Return

BR_SOUND_RESULT:
If BR_SESSIONFIN=1
   Play 61,0
Else
   If BR_AWARD=0
      Play 25,0
   Else
      Play 49,0
   End If
End If
Return
