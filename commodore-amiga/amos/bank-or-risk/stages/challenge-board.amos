Hide
Curs Off
Palette $000,$FFF
Paper 0
Pen 1
BR_CAP=10
BR_GOAL=30
BR_MAXTURN=5
BR_BANKED=4
BR_TURNNO=2
BR_TOTAL=11
BR_LASTROLL=5
BR_HANDFIN=-1
BR_AWARD=0
BR_SESSIONFIN=0
BR_MSG$="Bust! This round secures zero."
Gosub BR_DRAW_STATE
Locate 1,21
Print "Supplied result. Any key finishes."
Wait Key
Show
End

BR_DRAW_STATE:
Cls 0
Ink 1
Locate 1,1
Print "BANK OR RISK"
Box 0,16 To 223,55
Locate 1,3
Print "Secured: ";BR_BANKED;"  Target: ";BR_GOAL
Locate 1,5
Print "Round ";BR_TURNNO;" of ";BR_MAXTURN
Ink 1
Box 0,64 To 223,111
Locate 1,9
Print "Round total: ";BR_TOTAL
Locate 1,11
Print "Limit: ";BR_CAP
Locate 1,12
If BR_HANDFIN
   Print "This round secured: ";BR_AWARD
Else
   Print "At risk until you bank."
End If
Locate 29,4
Print "Last roll"
Locate 31,13
Print BR_LASTROLL
Gosub BR_DRAW_DIE
Locate 1,15
If BR_SESSIONFIN<>0
   Print "Unused rounds: ";BR_MAXTURN-BR_TURNNO
Else
   Print "Rounds after this: ";BR_MAXTURN-BR_TURNNO
End If
Box 0,128 To 319,151
Locate 1,17
Print BR_MSG$
Box 0,160 To 319,183
Locate 1,21
If BR_SESSIONFIN<>0
   Print "A new challenge   Q quit"
Else
   If BR_HANDFIN
      Print "SPACE next round  Q quit"
   Else
      Print "R roll   B bank   Q quit"
   End If
End If
Return

BR_DRAW_DIE:
Ink 0
Bar 240,48 To 288,96
Ink 1
Box 240,48 To 288,96
If BR_LASTROLL=1
   Bar 262,70 To 266,74
End If
If BR_LASTROLL=2
   Bar 248,56 To 252,60
   Bar 276,84 To 280,88
End If
If BR_LASTROLL=3
   Bar 248,56 To 252,60
   Bar 262,70 To 266,74
   Bar 276,84 To 280,88
End If
If BR_LASTROLL=4
   Bar 248,56 To 252,60
   Bar 276,56 To 280,60
   Bar 248,84 To 252,88
   Bar 276,84 To 280,88
End If
If BR_LASTROLL=5
   Bar 248,56 To 252,60
   Bar 276,56 To 280,60
   Bar 262,70 To 266,74
   Bar 248,84 To 252,88
   Bar 276,84 To 280,88
End If
If BR_LASTROLL=6
   Bar 248,56 To 252,60
   Bar 276,56 To 280,60
   Bar 248,70 To 252,74
   Bar 276,70 To 280,74
   Bar 248,84 To 252,88
   Bar 276,84 To 280,88
End If
Return
