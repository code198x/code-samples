Hide
Curs Off
Palette $000,$FFF
Paper 0
Pen 1
Play Off
Wave 1 To 15
Volume 24
Set Envel 1,0 To 1,63
Set Envel 1,1 To 9,0
Set Envel 1,2 To 1,0
Set Envel 1,3 To 1,0
Set Envel 1,4 To 1,0
Set Envel 1,5 To 1,0
Set Envel 1,6 To 1,0
Cls 0
BR_CAP=10
BR_LASTSC=-1
Cls 0
Locate 1,2
Print "BANK OR RISK"
Locate 1,5
Print "Play five rounds. Aim for 30."
Print "Roll 1-6. Over 10 loses the round."
Print "Exactly 10 banks automatically."
Locate 1,9
Print "Finish all five. Build your score."
Locate 1,12
Print "SPACE starts. Q returns to editor."
Repeat
   Gosub BR_READ_FRESH
Until BR_K$=" " Or BR_K$="Q"
If BR_K$="Q"
   Play Off
   Show
   End
End If
Randomize Timer
BR_MAXTURN=5
BR_GOAL=30
Repeat
   Play Off
   BR_BANKED=0
   BR_DONE=0
   BR_SESSIONFIN=0
   Repeat
      BR_TOTAL=0
      BR_LASTROLL=0
      BR_AWARD=0
      BR_HANDFIN=0
      BR_MSG$="Roll once before you can bank."
      Repeat
         Gosub BR_DRAW_STATE
         Locate 1,21
         Print "R roll   B bank   Q quit"
         Gosub BR_READ_FRESH
         If BR_K$="Q"
            Play Off
            Show
            End
         End If
         If BR_K$="R"
            BR_FACE=Rnd(5)+1
            BR_LASTROLL=BR_FACE
            BR_TOTAL=BR_TOTAL+BR_FACE
            BR_MSG$="Bank it or risk another roll?"
            If BR_TOTAL>BR_CAP
               BR_AWARD=0
               BR_HANDFIN=-1
               BR_MSG$="Bust! This round secures zero."
            End If
            If BR_TOTAL=BR_CAP
               BR_AWARD=BR_TOTAL
               BR_HANDFIN=-1
               BR_MSG$="Perfect 10. Secured automatically."
            End If
         End If
         If BR_K$="B"
            If BR_TOTAL>0
               BR_AWARD=BR_TOTAL
               BR_HANDFIN=-1
               BR_MSG$="Banked. These points are safe."
            End If
         End If
      Until BR_HANDFIN
      BR_BANKED=BR_BANKED+BR_AWARD
      BR_DONE=BR_DONE+1
      If BR_DONE=BR_MAXTURN
         If BR_BANKED>=BR_GOAL
            BR_SESSIONFIN=1
            BR_MSG$="Five rounds. Target reached!"
         Else
            BR_SESSIONFIN=-1
            BR_MSG$="Five rounds. Try for a new best."
         End If
      Else
         If BR_BANKED>=BR_GOAL
            BR_MSG$="30 reached. Keep building!"
         Else
            If BR_BANKED+BR_CAP*(BR_MAXTURN-BR_DONE)<BR_GOAL
               BR_MSG$="30 out of reach. Build your score."
            End If
         End If
      End If
      Gosub BR_SOUND_RESULT
      Gosub BR_DRAW_STATE
      Locate 1,21
      If BR_DONE<BR_MAXTURN
         Print "SPACE next round   Q quit"
         Repeat
            Gosub BR_READ_FRESH
         Until BR_K$=" " Or BR_K$="Q"
      End If
   Until BR_DONE=BR_MAXTURN Or BR_K$="Q"
   If BR_K$<>"Q"
      Locate 1,21
      Print "A new challenge    Q quit"
      Repeat
         Gosub BR_READ_FRESH
      Until BR_K$="A" Or BR_K$="Q"
   End If
Until BR_K$="Q"
Play Off
Show
End

BR_DRAW_STATE:
Cls 0
Ink 1
Locate 1,1
Print "BANK OR RISK"
Box 0,16 To 223,55
Locate 1,3
Print "Secured: ";BR_BANKED;"  Target: ";BR_GOAL
Locate 1,5
Print "Completed: ";BR_DONE;" of ";BR_MAXTURN
Box 0,64 To 223,111
Locate 1,9
Print "Round total: ";BR_TOTAL
Locate 1,11
Print "Limit: ";BR_CAP
Locate 1,12
If BR_HANDFIN
   Print "This round secured: ";BR_AWARD
Else
   Print "At risk until you bank."
End If
Locate 29,4
Print "Last roll"
Locate 31,13
Print BR_LASTROLL
Gosub BR_DRAW_DIE
Locate 1,15
If BR_SESSIONFIN<>0
   Print "Unused rounds: ";BR_MAXTURN-BR_DONE
Else
   If BR_HANDFIN
      Print "Rounds left: ";BR_MAXTURN-BR_DONE
   Else
      Print "Rounds after this: ";BR_MAXTURN-BR_DONE-1
   End If
End If
Box 0,128 To 319,151
Locate 1,17
Print BR_MSG$
Box 0,160 To 319,183
Return

BR_READ_FRESH:
If BR_LASTSC>=0
   Repeat
      Wait Vbl
   Until Key State(BR_LASTSC)=0
End If
Clear Key
Repeat
   BR_K$=Upper$(Inkey$)
   Wait Vbl
Until BR_K$<>""
BR_LASTSC=Scancode
Return

BR_DRAW_DIE:
Ink 0
Bar 240,48 To 288,96
Ink 1
Box 240,48 To 288,96
If BR_LASTROLL=1
   Bar 262,70 To 266,74
End If
If BR_LASTROLL=2
   Bar 248,56 To 252,60
   Bar 276,84 To 280,88
End If
If BR_LASTROLL=3
   Bar 248,56 To 252,60
   Bar 262,70 To 266,74
   Bar 276,84 To 280,88
End If
If BR_LASTROLL=4
   Bar 248,56 To 252,60
   Bar 276,56 To 280,60
   Bar 248,84 To 252,88
   Bar 276,84 To 280,88
End If
If BR_LASTROLL=5
   Bar 248,56 To 252,60
   Bar 276,56 To 280,60
   Bar 262,70 To 266,74
   Bar 248,84 To 252,88
   Bar 276,84 To 280,88
End If
If BR_LASTROLL=6
   Bar 248,56 To 252,60
   Bar 276,56 To 280,60
   Bar 248,70 To 252,74
   Bar 276,70 To 280,74
   Bar 248,84 To 252,88
   Bar 276,84 To 280,88
End If
Return

BR_SOUND_RESULT:
If BR_SESSIONFIN=1
   Play 61,0
Else
   If BR_AWARD=0
      Play 25,0
   Else
      Play 49,0
   End If
End If
Return
