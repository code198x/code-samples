Hide
Curs Off
Flash Off
Double Buffer
Autoback 0
Bob Update Off
Get Rom Fonts
Set Font 1
BR_BASE=Text Base
BR_LETTERS$="0123456789BANKORIS"
Dim BR_GLYPH$(18)
BR_GLYPH$(1)="01110100011001110101110011000101110"
BR_GLYPH$(2)="00100011000010000100001000010001110"
BR_GLYPH$(3)="01110100010000100010001000100011111"
BR_GLYPH$(4)="11110000010000101110000010000111110"
BR_GLYPH$(5)="00010001100101010010111110001000010"
BR_GLYPH$(6)="11111100001000011110000010000111110"
BR_GLYPH$(7)="01110100001000011110100011000101110"
BR_GLYPH$(8)="11111000010001000100010000100001000"
BR_GLYPH$(9)="01110100011000101110100011000101110"
BR_GLYPH$(10)="01110100011000101111000010000101110"
BR_GLYPH$(11)="11110100011000111110100011000111110"
BR_GLYPH$(12)="01110100011000111111100011000110001"
BR_GLYPH$(13)="10001110011100110101100111001110001"
BR_GLYPH$(14)="10001100101010011000101001001010001"
BR_GLYPH$(15)="01110100011000110001100011000101110"
BR_GLYPH$(16)="11110100011000111110101001001010001"
BR_GLYPH$(17)="11111001000010000100001000010011111"
BR_GLYPH$(18)="01111100001000001110000010000111110"
Palette $112,$FFE,$4FF,$F6B,$FE4,$224,$7F9,$BAD
Paper 0
BR_PAPER=0
Pen 1
BR_PEN=1
Play Off
Wave 1 To 15
Volume 24
Set Envel 1,0 To 1,63
Set Envel 1,1 To 9,0
Set Envel 1,2 To 1,0
Set Envel 1,3 To 1,0
Set Envel 1,4 To 1,0
Set Envel 1,5 To 1,0
Set Envel 1,6 To 1,0
Cls 0
BR_CAP=10
BR_LASTSC=-1
BR_ANIMATE=1
Cls 0
Paper 0
BR_PAPER=0
Pen 3
BR_PEN=3
BR_TX=(1)*8
BR_TY=(2)*8+BR_BASE
BR_WORD$="BANK OR RISK"
BR_GX=8
BR_GY=16
BR_SCALE=2
BR_GINK=3
Gosub BR_LETTERING
Ink 2
Bar 8,32 To 311,33
Pen 2
BR_PEN=2
BR_TX=(1)*8
BR_TY=(6)*8+BR_BASE
BR_TEXT$="Five rounds. Aim for 30."
Gosub BR_LABEL
Pen 1
BR_PEN=1
BR_TX=(1)*8
BR_TY=(9)*8+BR_BASE
BR_TEXT$="Roll 1-6. Over 10 loses the round."
Gosub BR_LABEL
BR_TX=(1)*8
BR_TY=(11)*8+BR_BASE
BR_TEXT$="Exactly 10 banks automatically."
Gosub BR_LABEL
Pen 6
BR_PEN=6
BR_TX=(1)*8
BR_TY=(15)*8+BR_BASE
BR_TEXT$="One rescue: U undoes a bust."
Gosub BR_LABEL
Pen 1
BR_PEN=1
BR_TX=(1)*8
BR_TY=(17)*8+BR_BASE
BR_TEXT$="B accepts it and keeps the rescue."
Gosub BR_LABEL
Pen 4
BR_PEN=4
BR_TX=(1)*8
BR_TY=(22)*8+BR_BASE
BR_TEXT$="SPACE starts   Q returns to editor"
Gosub BR_LABEL
Pen 1
BR_PEN=1
Repeat
   Gosub BR_READ_FRESH
Until BR_K$=" " Or BR_K$="Q"
If BR_K$="Q"
   Play Off
   Show
   End
End If
Randomize Timer
BR_BEST=0
BR_MAXTURN=5
BR_GOAL=30
Dim BR_MARK(BR_MAXTURN)
Repeat
   Play Off
   BR_BANKED=0
   BR_NEWBEST=0
   For BR_SLOT=1 To BR_MAXTURN
      BR_MARK(BR_SLOT)=0
   Next BR_SLOT
   BR_DONE=0
   BR_SESSIONFIN=0
   BR_RESCUE=1
   BR_REACHED=0
   Repeat
      BR_TOTAL=0
      BR_LASTROLL=0
      BR_AWARD=0
      BR_HANDFIN=0
      BR_RESCUEASK=0
      BR_TARGETCUE=0
      BR_MSG$="Roll once before you can bank."
      Repeat
         Gosub BR_DRAW_STATE
         BR_TX=(1)*8
         BR_TY=(23)*8+BR_BASE
         If BR_RESCUEASK
            BR_TEXT$="U rescue   B accept bust   Q quit"
            Gosub BR_LABEL
         Else
            BR_TEXT$="R roll   B bank   Q quit"
            Gosub BR_LABEL
         End If
         Gosub BR_READ_FRESH
         If BR_K$="Q"
            Play Off
            Show
            End
         End If
         If BR_RESCUEASK
            If BR_K$="U"
               BR_RESCUE=0
               BR_RESCUEASK=0
               BR_TOTAL=BR_BEFORE
               BR_LASTROLL=BR_BEFOREFACE
               BR_MSG$="Rescued. Bank it or risk a roll."
            End If
            If BR_K$="B"
               BR_RESCUEASK=0
               BR_AWARD=0
               BR_HANDFIN=-1
               BR_MSG$="Bust accepted. Rescue kept."
            End If
         Else
            If BR_K$="R"
               BR_BEFORE=BR_TOTAL
               BR_BEFOREFACE=BR_LASTROLL
               BR_FACE=Rnd(5)+1
               Gosub BR_ROLL_PICTURE
               BR_LASTROLL=BR_FACE
               BR_TOTAL=BR_TOTAL+BR_FACE
               BR_MSG$="Bank it or risk another roll?"
               If BR_TOTAL>BR_CAP
                  If BR_RESCUE
                     BR_RESCUEASK=-1
                     BR_MSG$="Bust! Rescue it or accept zero."
                  Else
                     BR_AWARD=0
                     BR_HANDFIN=-1
                     BR_MSG$="Bust! This round secures zero."
                  End If
               End If
               If BR_TOTAL=BR_CAP
                  BR_AWARD=BR_TOTAL
                  BR_HANDFIN=-1
                  BR_MSG$="Perfect 10. Secured automatically."
               End If
            End If
            If BR_K$="B"
               If BR_TOTAL>0
                  BR_AWARD=BR_TOTAL
                  BR_HANDFIN=-1
                  BR_MSG$="Banked. These points are safe."
               End If
            End If
         End If
      Until BR_HANDFIN
      BR_BANKED=BR_BANKED+BR_AWARD
      BR_DONE=BR_DONE+1
      BR_MARK(BR_DONE)=BR_AWARD
      If BR_DONE=BR_MAXTURN
         If BR_BANKED>=BR_GOAL
            BR_SESSIONFIN=1
            BR_MSG$="Five rounds. Target reached!"
         Else
            BR_SESSIONFIN=-1
            BR_MSG$="Five rounds. Try for a new best."
         End If
      Else
         If BR_BANKED>=BR_GOAL
            BR_MSG$="30 reached. Keep building!"
         Else
            If BR_BANKED+BR_CAP*(BR_MAXTURN-BR_DONE)<BR_GOAL
               BR_MSG$="30 out of reach. Build your score."
            End If
         End If
      End If
      If BR_DONE=BR_MAXTURN
         If BR_BANKED>BR_BEST
            BR_BEST=BR_BANKED
            BR_NEWBEST=-1
         End If
      End If
      BR_TARGETCUE=0
      If BR_BANKED>=BR_GOAL And BR_REACHED=0
         BR_REACHED=-1
         BR_TARGETCUE=-1
      End If
      Gosub BR_SOUND_RESULT
      Gosub BR_DRAW_STATE
      BR_TX=(1)*8
      BR_TY=(23)*8+BR_BASE
      If BR_DONE<BR_MAXTURN
         BR_TEXT$="SPACE next round   Q quit"
         Gosub BR_LABEL
         Repeat
            Gosub BR_READ_FRESH
         Until BR_K$=" " Or BR_K$="Q"
      End If
   Until BR_DONE=BR_MAXTURN Or BR_K$="Q"
   If BR_K$<>"Q"
      BR_TX=(1)*8
      BR_TY=(23)*8+BR_BASE
      BR_TEXT$="A new challenge    Q quit"
      Gosub BR_LABEL
      Repeat
         Gosub BR_READ_FRESH
      Until BR_K$="A" Or BR_K$="Q"
   End If
Until BR_K$="Q"
Play Off
Show
End

BR_DRAW_STATE:
Cls 0
Paper 0
BR_PAPER=0
Pen 3
BR_PEN=3
BR_TX=(1)*8
BR_TY=(1)*8+BR_BASE
BR_WORD$="BANK OR RISK"
BR_GX=8
BR_GY=8
BR_SCALE=1
BR_GINK=3
Gosub BR_LETTERING
BR_TX=(25)*8
BR_TY=(1)*8+BR_BASE
If BR_NEWBEST
   Pen 6
   BR_PEN=6
   BR_TEXT$="NEW BEST "+Str$(BR_BEST)
   Gosub BR_LABEL
Else
   Pen 1
   BR_PEN=1
   BR_TEXT$="BEST "+Str$(BR_BEST)
   Gosub BR_LABEL
End If
Ink 2
Bar 8,20 To 311,21
Pen 2
BR_PEN=2
BR_TX=(1)*8
BR_TY=(4)*8+BR_BASE
BR_TEXT$="SECURED"
Gosub BR_LABEL
BR_WORD$=Str$(BR_BANKED)
BR_GX=80
BR_GY=29
BR_SCALE=2
BR_GINK=2
Gosub BR_LETTERING
Pen 7
BR_PEN=7
BR_TX=(24)*8
BR_TY=(4)*8+BR_BASE
BR_TEXT$="GOAL: "+Str$(BR_GOAL)
Gosub BR_LABEL
BR_TX=(1)*8
BR_TY=(6)*8+BR_BASE
BR_TEXT$="Completed: "+Str$(BR_DONE)+"/"+Str$(BR_MAXTURN)
Gosub BR_LABEL
Pen 7
BR_PEN=7
BR_TX=(31)*8
BR_TY=(5)*8+BR_BASE
BR_TEXT$="DIE"
Gosub BR_LABEL
Ink 5
Bar 8,64 To 215,112
Paper 5
BR_PAPER=5
Pen 4
BR_PEN=4
BR_TX=(2)*8
BR_TY=(9)*8+BR_BASE
BR_TEXT$="ROUND TOTAL"
Gosub BR_LABEL
BR_WORD$=Str$(BR_TOTAL)
BR_GX=168
BR_GY=73
BR_SCALE=2
BR_GINK=4
Gosub BR_LETTERING
Pen 1
BR_PEN=1
BR_TX=(2)*8
BR_TY=(11)*8+BR_BASE
BR_TEXT$="Limit: "+Str$(BR_CAP)
Gosub BR_LABEL
BR_TX=(2)*8
BR_TY=(13)*8+BR_BASE
If BR_RESCUEASK
   Pen 3
   BR_PEN=3
   BR_TEXT$="Rescue or accept bust."
   Gosub BR_LABEL
Else
   If BR_HANDFIN
      Pen 2
      BR_PEN=2
      BR_TEXT$="Saved: +"+Str$(BR_AWARD)
      Gosub BR_LABEL
   Else
      Pen 4
      BR_PEN=4
      BR_TEXT$="Unbanked points."
      Gosub BR_LABEL
   End If
End If
Paper 0
BR_PAPER=0
BR_DX=248
BR_DY=56
Gosub BR_DRAW_DIE
Pen 7
BR_PEN=7
BR_TX=(30)*8
BR_TY=(15)*8+BR_BASE
If BR_LASTROLL=0
   BR_TEXT$="No roll"
   Gosub BR_LABEL
Else
   BR_TEXT$="Last "+Str$(BR_LASTROLL)
   Gosub BR_LABEL
End If
BR_TX=(1)*8
BR_TY=(15)*8+BR_BASE
If BR_RESCUE
   Pen 6
   BR_PEN=6
   BR_TEXT$="Rescue: READY"
   Gosub BR_LABEL
Else
   Pen 7
   BR_PEN=7
   BR_TEXT$="Rescue: USED"
   Gosub BR_LABEL
End If
Pen 1
BR_PEN=1
BR_TX=(1)*8
BR_TY=(17)*8+BR_BASE
BR_TEXT$=BR_MSG$
Gosub BR_LABEL
For BR_SLOT=1 To BR_MAXTURN
   BR_SX=8+(BR_SLOT-1)*64
   Ink 5
   Bar BR_SX,152 To BR_SX+47,175
   Ink 7
   If BR_SLOT<=BR_DONE
      Ink 2
   Else
      If BR_SLOT=BR_DONE+1 And BR_HANDFIN=0
         Ink 4
      End If
   End If
   Bar BR_SX,149 To BR_SX+47,150
   Paper 5
   BR_PAPER=5
   Pen 7
   BR_PEN=7
   BR_TX=(2+(BR_SLOT-1)*8)*8
   BR_TY=(19)*8+BR_BASE
   BR_TEXT$="R"+Str$(BR_SLOT)
   Gosub BR_LABEL
   BR_TX=(3+(BR_SLOT-1)*8)*8
   BR_TY=(20)*8+BR_BASE
   If BR_SLOT<=BR_DONE
      Pen 2
      BR_PEN=2
      BR_TEXT$=Str$(BR_MARK(BR_SLOT))
      Gosub BR_LABEL
   Else
      If BR_SLOT=BR_DONE+1 And BR_HANDFIN=0
         Pen 4
         BR_PEN=4
         BR_TEXT$="?"
         Gosub BR_LABEL
      Else
         Pen 7
         BR_PEN=7
         BR_TEXT$="-"
         Gosub BR_LABEL
      End If
   End If
Next BR_SLOT
Paper 0
BR_PAPER=0
Pen 1
BR_PEN=1
Return

BR_READ_FRESH:
Gosub BR_PRESENT
If BR_LASTSC>=0
   Repeat
      Wait Vbl
   Until Key State(BR_LASTSC)=0
End If
Clear Key
Repeat
   BR_K$=Upper$(Inkey$)
   Wait Vbl
Until BR_K$<>""
BR_LASTSC=Scancode
Return

BR_DRAW_DIE:
Ink 0
Bar 244,52 To 308,116
If BR_LASTROLL=0
   Ink 5
   Bar BR_DX,BR_DY To BR_DX+56,BR_DY+56
   Ink 7
   Box BR_DX,BR_DY To BR_DX+56,BR_DY+56
Else
   Ink 1
   Bar BR_DX,BR_DY To BR_DX+56,BR_DY+56
   Ink 0
   If BR_LASTROLL=1
      Bar BR_DX+25,BR_DY+25 To BR_DX+31,BR_DY+31
   End If
   If BR_LASTROLL=2
      Bar BR_DX+9,BR_DY+9 To BR_DX+15,BR_DY+15
      Bar BR_DX+41,BR_DY+41 To BR_DX+47,BR_DY+47
   End If
   If BR_LASTROLL=3
      Bar BR_DX+9,BR_DY+9 To BR_DX+15,BR_DY+15
      Bar BR_DX+25,BR_DY+25 To BR_DX+31,BR_DY+31
      Bar BR_DX+41,BR_DY+41 To BR_DX+47,BR_DY+47
   End If
   If BR_LASTROLL=4
      Bar BR_DX+9,BR_DY+9 To BR_DX+15,BR_DY+15
      Bar BR_DX+41,BR_DY+9 To BR_DX+47,BR_DY+15
      Bar BR_DX+9,BR_DY+41 To BR_DX+15,BR_DY+47
      Bar BR_DX+41,BR_DY+41 To BR_DX+47,BR_DY+47
   End If
   If BR_LASTROLL=5
      Bar BR_DX+9,BR_DY+9 To BR_DX+15,BR_DY+15
      Bar BR_DX+41,BR_DY+9 To BR_DX+47,BR_DY+15
      Bar BR_DX+25,BR_DY+25 To BR_DX+31,BR_DY+31
      Bar BR_DX+9,BR_DY+41 To BR_DX+15,BR_DY+47
      Bar BR_DX+41,BR_DY+41 To BR_DX+47,BR_DY+47
   End If
   If BR_LASTROLL=6
      Bar BR_DX+9,BR_DY+9 To BR_DX+15,BR_DY+15
      Bar BR_DX+41,BR_DY+9 To BR_DX+47,BR_DY+15
      Bar BR_DX+9,BR_DY+25 To BR_DX+15,BR_DY+31
      Bar BR_DX+41,BR_DY+25 To BR_DX+47,BR_DY+31
      Bar BR_DX+9,BR_DY+41 To BR_DX+15,BR_DY+47
      Bar BR_DX+41,BR_DY+41 To BR_DX+47,BR_DY+47
   End If
End If
Return

BR_SOUND_RESULT:
If BR_TARGETCUE
   Play 61,0
Else
   If BR_AWARD=0
      Play 25,0
   Else
      Play 49,0
   End If
End If
Return

BR_ROLL_PICTURE:
If BR_ANIMATE
   Paper 0
   BR_PAPER=0
   Pen 4
   BR_PEN=4
   BR_TX=(1)*8
   BR_TY=(23)*8+BR_BASE
   BR_TEXT$="Rolling... Q quits                   "
   Gosub BR_LABEL
   For BR_SPIN=1 To 6
      BR_LASTROLL=7-BR_SPIN
      If BR_SPIN=2 Or BR_SPIN=4 Or BR_SPIN=6
         BR_DX=250
         BR_DY=54
      Else
         BR_DX=246
         BR_DY=58
      End If
      Gosub BR_DRAW_DIE
      Gosub BR_PRESENT
      For BR_TICK=1 To BR_SPIN
         Wait Vbl
         BR_ANIMKEY$=Upper$(Inkey$)
         If BR_ANIMKEY$="Q"
            Play Off
            Show
            End
         End If
      Next BR_TICK
   Next BR_SPIN
End If
BR_DX=248
BR_DY=56
Paper 0
BR_PAPER=0
Pen 1
BR_PEN=1
Return

BR_PRESENT:
Screen Swap
Wait Vbl
Screen Copy Physic To Logic
Return

BR_LABEL:
Ink BR_PEN,BR_PAPER
Text BR_TX,BR_TY,BR_TEXT$
Return

BR_LETTERING:
Ink BR_GINK
For BR_CHAR=1 To Len(BR_WORD$)
   BR_GINDEX=Instr(BR_LETTERS$,Mid$(BR_WORD$,BR_CHAR,1))
   If BR_GINDEX>0
      For BR_GROW=0 To 6
         For BR_GCOL=0 To 4
            If Mid$(BR_GLYPH$(BR_GINDEX),BR_GROW*5+BR_GCOL+1,1)="1"
               BR_PX=BR_GX+((BR_CHAR-1)*6+BR_GCOL)*BR_SCALE
               BR_PY=BR_GY+BR_GROW*BR_SCALE
               If BR_SCALE=1
                  Plot BR_PX,BR_PY
               Else
                  Bar BR_PX,BR_PY To BR_PX+BR_SCALE-1,BR_PY+BR_SCALE-1
               End If
            End If
         Next BR_GCOL
      Next BR_GROW
   End If
Next BR_CHAR
Return
