Hide
Curs Off
Flash Off
Palette $112,$FFE,$4FF,$F6B,$FE4,$224,$7F9,$BAD
Paper 0
Pen 1
Play Off
Wave 1 To 15
Volume 24
Set Envel 1,0 To 1,63
Set Envel 1,1 To 9,0
Set Envel 1,2 To 1,0
Set Envel 1,3 To 1,0
Set Envel 1,4 To 1,0
Set Envel 1,5 To 1,0
Set Envel 1,6 To 1,0
Cls 0
BR_CAP=10
BR_LASTSC=-1
BR_ANIMATE=1
Cls 0
Paper 0
Pen 3
Locate 1,2
Print "BANK OR RISK"
Ink 2
Bar 8,32 To 311,33
Pen 2
Locate 1,6
Print "Five rounds. Aim for 30."
Pen 1
Locate 1,9
Print "Roll 1-6. Over 10 loses the round."
Locate 1,11
Print "Exactly 10 banks automatically."
Pen 6
Locate 1,15
Print "One rescue: U undoes a bust."
Pen 1
Locate 1,17
Print "B accepts it and keeps the rescue."
Pen 4
Locate 1,22
Print "SPACE starts   Q returns to editor"
Pen 1
Repeat
   Gosub BR_READ_FRESH
Until BR_K$=" " Or BR_K$="Q"
If BR_K$="Q"
   Play Off
   Show
   End
End If
Randomize Timer
BR_BEST=0
BR_MAXTURN=5
BR_GOAL=30
Dim BR_MARK(BR_MAXTURN)
Repeat
   Play Off
   BR_BANKED=0
   BR_NEWBEST=0
   For BR_SLOT=1 To BR_MAXTURN
      BR_MARK(BR_SLOT)=0
   Next BR_SLOT
   BR_DONE=0
   BR_SESSIONFIN=0
   BR_RESCUE=1
   BR_REACHED=0
   Repeat
      BR_TOTAL=0
      BR_LASTROLL=0
      BR_AWARD=0
      BR_HANDFIN=0
      BR_RESCUEASK=0
      BR_TARGETCUE=0
      BR_MSG$="Roll once before you can bank."
      Repeat
         Gosub BR_DRAW_STATE
         Locate 1,23
         If BR_RESCUEASK
            Print "U rescue   B accept bust   Q quit"
         Else
            Print "R roll   B bank   Q quit"
         End If
         Gosub BR_READ_FRESH
         If BR_K$="Q"
            Play Off
            Show
            End
         End If
         If BR_RESCUEASK
            If BR_K$="U"
               BR_RESCUE=0
               BR_RESCUEASK=0
               BR_TOTAL=BR_BEFORE
               BR_LASTROLL=BR_BEFOREFACE
               BR_MSG$="Rescued. Bank it or risk a roll."
            End If
            If BR_K$="B"
               BR_RESCUEASK=0
               BR_AWARD=0
               BR_HANDFIN=-1
               BR_MSG$="Bust accepted. Rescue kept."
            End If
         Else
            If BR_K$="R"
               BR_BEFORE=BR_TOTAL
               BR_BEFOREFACE=BR_LASTROLL
               BR_FACE=Rnd(5)+1
               Gosub BR_ROLL_PICTURE
               BR_LASTROLL=BR_FACE
               BR_TOTAL=BR_TOTAL+BR_FACE
               BR_MSG$="Bank it or risk another roll?"
               If BR_TOTAL>BR_CAP
                  If BR_RESCUE
                     BR_RESCUEASK=-1
                     BR_MSG$="Bust! Rescue it or accept zero."
                  Else
                     BR_AWARD=0
                     BR_HANDFIN=-1
                     BR_MSG$="Bust! This round secures zero."
                  End If
               End If
               If BR_TOTAL=BR_CAP
                  BR_AWARD=BR_TOTAL
                  BR_HANDFIN=-1
                  BR_MSG$="Perfect 10. Secured automatically."
               End If
            End If
            If BR_K$="B"
               If BR_TOTAL>0
                  BR_AWARD=BR_TOTAL
                  BR_HANDFIN=-1
                  BR_MSG$="Banked. These points are safe."
               End If
            End If
         End If
      Until BR_HANDFIN
      BR_BANKED=BR_BANKED+BR_AWARD
      BR_DONE=BR_DONE+1
      BR_MARK(BR_DONE)=BR_AWARD
      If BR_DONE=BR_MAXTURN
         If BR_BANKED>=BR_GOAL
            BR_SESSIONFIN=1
            BR_MSG$="Five rounds. Target reached!"
         Else
            BR_SESSIONFIN=-1
            BR_MSG$="Five rounds. Try for a new best."
         End If
      Else
         If BR_BANKED>=BR_GOAL
            BR_MSG$="30 reached. Keep building!"
         Else
            If BR_BANKED+BR_CAP*(BR_MAXTURN-BR_DONE)<BR_GOAL
               BR_MSG$="30 out of reach. Build your score."
            End If
         End If
      End If
      If BR_DONE=BR_MAXTURN
         If BR_BANKED>BR_BEST
            BR_BEST=BR_BANKED
            BR_NEWBEST=-1
         End If
      End If
      BR_TARGETCUE=0
      If BR_BANKED>=BR_GOAL And BR_REACHED=0
         BR_REACHED=-1
         BR_TARGETCUE=-1
      End If
      Gosub BR_SOUND_RESULT
      Gosub BR_DRAW_STATE
      Locate 1,23
      If BR_DONE<BR_MAXTURN
         Print "SPACE next round   Q quit"
         Repeat
            Gosub BR_READ_FRESH
         Until BR_K$=" " Or BR_K$="Q"
      End If
   Until BR_DONE=BR_MAXTURN Or BR_K$="Q"
   If BR_K$<>"Q"
      Locate 1,23
      Print "A new challenge    Q quit"
      Repeat
         Gosub BR_READ_FRESH
      Until BR_K$="A" Or BR_K$="Q"
   End If
Until BR_K$="Q"
Play Off
Show
End

BR_DRAW_STATE:
Cls 0
Paper 0
Pen 3
Locate 1,1
Print "BANK OR RISK"
Locate 25,1
If BR_NEWBEST
   Pen 6
   Print "NEW BEST ";BR_BEST
Else
   Pen 1
   Print "BEST ";BR_BEST
End If
Ink 2
Bar 8,20 To 311,21
Pen 2
Locate 1,4
Print "SECURED: ";BR_BANKED
Pen 7
Locate 24,4
Print "GOAL: ";BR_GOAL
Locate 1,6
Print "Completed: ";BR_DONE;"/";BR_MAXTURN
Pen 7
Locate 31,5
Print "DIE"
Ink 5
Bar 8,64 To 215,112
Paper 5
Pen 4
Locate 2,9
Print "ROUND TOTAL: ";BR_TOTAL
Pen 1
Locate 2,11
Print "Limit: ";BR_CAP
Locate 2,13
If BR_RESCUEASK
   Pen 3
   Print "Rescue or accept bust."
Else
   If BR_HANDFIN
      Pen 2
      Print "Saved: +";BR_AWARD
   Else
      Pen 4
      Print "Unbanked points."
   End If
End If
Paper 0
BR_DX=248
BR_DY=56
Gosub BR_DRAW_DIE
Pen 7
Locate 30,15
If BR_LASTROLL=0
   Print "No roll"
Else
   Print "Last ";BR_LASTROLL
End If
Locate 1,15
If BR_RESCUE
   Pen 6
   Print "Rescue: READY"
Else
   Pen 7
   Print "Rescue: USED"
End If
Pen 1
Locate 1,17
Print BR_MSG$
For BR_SLOT=1 To BR_MAXTURN
   BR_SX=8+(BR_SLOT-1)*64
   Ink 5
   Bar BR_SX,152 To BR_SX+47,175
   Ink 7
   If BR_SLOT<=BR_DONE
      Ink 2
   Else
      If BR_SLOT=BR_DONE+1 And BR_HANDFIN=0
         Ink 4
      End If
   End If
   Bar BR_SX,149 To BR_SX+47,150
   Paper 5
   Pen 7
   Locate 2+(BR_SLOT-1)*8,19
   Print "R";BR_SLOT
   Locate 3+(BR_SLOT-1)*8,20
   If BR_SLOT<=BR_DONE
      Pen 2
      Print BR_MARK(BR_SLOT)
   Else
      If BR_SLOT=BR_DONE+1 And BR_HANDFIN=0
         Pen 4
         Print "?"
      Else
         Pen 7
         Print "-"
      End If
   End If
Next BR_SLOT
Paper 0
Pen 1
Return

BR_READ_FRESH:
If BR_LASTSC>=0
   Repeat
      Wait Vbl
   Until Key State(BR_LASTSC)=0
End If
Clear Key
Repeat
   BR_K$=Upper$(Inkey$)
   Wait Vbl
Until BR_K$<>""
BR_LASTSC=Scancode
Return

BR_DRAW_DIE:
Ink 0
Bar 244,52 To 308,116
If BR_LASTROLL=0
   Ink 5
   Bar BR_DX,BR_DY To BR_DX+56,BR_DY+56
   Ink 7
   Box BR_DX,BR_DY To BR_DX+56,BR_DY+56
Else
   Ink 1
   Bar BR_DX,BR_DY To BR_DX+56,BR_DY+56
   Ink 0
   If BR_LASTROLL=1
      Bar BR_DX+25,BR_DY+25 To BR_DX+31,BR_DY+31
   End If
   If BR_LASTROLL=2
      Bar BR_DX+9,BR_DY+9 To BR_DX+15,BR_DY+15
      Bar BR_DX+41,BR_DY+41 To BR_DX+47,BR_DY+47
   End If
   If BR_LASTROLL=3
      Bar BR_DX+9,BR_DY+9 To BR_DX+15,BR_DY+15
      Bar BR_DX+25,BR_DY+25 To BR_DX+31,BR_DY+31
      Bar BR_DX+41,BR_DY+41 To BR_DX+47,BR_DY+47
   End If
   If BR_LASTROLL=4
      Bar BR_DX+9,BR_DY+9 To BR_DX+15,BR_DY+15
      Bar BR_DX+41,BR_DY+9 To BR_DX+47,BR_DY+15
      Bar BR_DX+9,BR_DY+41 To BR_DX+15,BR_DY+47
      Bar BR_DX+41,BR_DY+41 To BR_DX+47,BR_DY+47
   End If
   If BR_LASTROLL=5
      Bar BR_DX+9,BR_DY+9 To BR_DX+15,BR_DY+15
      Bar BR_DX+41,BR_DY+9 To BR_DX+47,BR_DY+15
      Bar BR_DX+25,BR_DY+25 To BR_DX+31,BR_DY+31
      Bar BR_DX+9,BR_DY+41 To BR_DX+15,BR_DY+47
      Bar BR_DX+41,BR_DY+41 To BR_DX+47,BR_DY+47
   End If
   If BR_LASTROLL=6
      Bar BR_DX+9,BR_DY+9 To BR_DX+15,BR_DY+15
      Bar BR_DX+41,BR_DY+9 To BR_DX+47,BR_DY+15
      Bar BR_DX+9,BR_DY+25 To BR_DX+15,BR_DY+31
      Bar BR_DX+41,BR_DY+25 To BR_DX+47,BR_DY+31
      Bar BR_DX+9,BR_DY+41 To BR_DX+15,BR_DY+47
      Bar BR_DX+41,BR_DY+41 To BR_DX+47,BR_DY+47
   End If
End If
Return

BR_SOUND_RESULT:
If BR_TARGETCUE
   Play 61,0
Else
   If BR_AWARD=0
      Play 25,0
   Else
      Play 49,0
   End If
End If
Return

BR_ROLL_PICTURE:
If BR_ANIMATE
   Paper 0
   Pen 4
   Locate 1,23
   Print "Rolling... Q quits                   "
   For BR_SPIN=1 To 6
      BR_LASTROLL=7-BR_SPIN
      If BR_SPIN=2 Or BR_SPIN=4 Or BR_SPIN=6
         BR_DX=250
         BR_DY=54
      Else
         BR_DX=246
         BR_DY=58
      End If
      Gosub BR_DRAW_DIE
      For BR_TICK=1 To BR_SPIN
         Wait Vbl
         BR_ANIMKEY$=Upper$(Inkey$)
         If BR_ANIMKEY$="Q"
            Play Off
            Show
            End
         End If
      Next BR_TICK
   Next BR_SPIN
End If
BR_DX=248
BR_DY=56
Paper 0
Pen 1
Return
