Hide
Curs Off
Paper 0
Pen 1
CAP=10
GOAL=30
MAXTURN=5
LASTSC=-1
APPQUIT=0
Cls 0
Locate 1,2
Print "BANK OR RISK"
Locate 1,5
Print "Secure 30 points in five rounds."
Print "Roll 1-6. Over 10 loses the round."
Print "Exactly 10 banks automatically."
Locate 1,10
Print "SPACE starts. Q returns to editor."
Repeat
   Gosub READ_FRESH
Until K$=" " Or K$="Q"
If K$="Q" Then APPQUIT=-1
Randomize Timer
While APPQUIT=0
   BANKED=0
   For TURNNO=1 To MAXTURN
      TOTAL=0
      LASTROLL=0
      AWARD=0
      HANDFIN=0
      SESSIONFIN=0
      MSG$="Roll once before you can bank."
      Repeat
         Gosub DRAW_STATE
         Gosub READ_FRESH
         If K$="Q"
            APPQUIT=-1
            Exit
         End If
         If K$="R"
            FACE=Rnd(5)+1
            LASTROLL=FACE
            TOTAL=TOTAL+FACE
            MSG$="Bank it or risk another roll?"
            If TOTAL>CAP
               AWARD=0
               HANDFIN=-1
               MSG$="Bust! This round secures zero."
            Else
               If TOTAL=CAP
                  AWARD=TOTAL
                  HANDFIN=-1
                  MSG$="Perfect 10. Secured automatically."
               End If
            End If
         End If
         If K$="B"
            If TOTAL>0
               AWARD=TOTAL
               HANDFIN=-1
               MSG$="Banked. These points are safe."
            Else
               MSG$="Roll once before you can bank."
            End If
         End If
      Until HANDFIN
      If APPQUIT Then Exit
      BANKED=BANKED+AWARD
      REMAIN=MAXTURN-TURNNO
      If BANKED>=GOAL
         SESSIONFIN=1
         MSG$="Target reached. You made it!"
      Else
         If BANKED+CAP*REMAIN<GOAL
            SESSIONFIN=-1
            MSG$="Target out of reach this time."
         End If
      End If
      If SESSIONFIN<>0 Then Exit
      Gosub DRAW_STATE
      Repeat
         Gosub READ_FRESH
         If K$="Q" Then APPQUIT=-1
      Until K$=" " Or APPQUIT
      If APPQUIT Then Exit
   Next TURNNO
   If APPQUIT Then Exit
   Gosub DRAW_STATE
   Repeat
      Gosub READ_FRESH
      If K$="Q" Then APPQUIT=-1
   Until K$="A" Or APPQUIT
Wend
Show
End

DRAW_STATE:
Cls 0
Locate 1,1
Print "BANK OR RISK"
Locate 1,3
Print "Round ";TURNNO;" of ";MAXTURN
Locate 1,4
Print "Limit ";CAP;"   Target ";GOAL
Locate 1,6
Print "Secured score: ";BANKED
Locate 1,8
Print "Current total: ";TOTAL
Locate 1,9
Print "Last roll:     ";LASTROLL
If HANDFIN
   Locate 1,11
   Print "Round secured: ";AWARD
End If
Locate 1,14
Print MSG$
Locate 1,18
If SESSIONFIN<>0
   Print "A new challenge   Q quit"
Else
   If HANDFIN
      Print "SPACE next round  Q quit"
   Else
      Print "R roll   B bank   Q quit"
   End If
End If
Return

READ_FRESH:
If LASTSC>=0
   Repeat
      Wait Vbl
   Until Key State(LASTSC)=0
End If
Clear Key
Repeat
   K$=Upper$(Inkey$)
   Wait Vbl
Until K$<>""
LASTSC=Scancode
Return
