Rem Integer globals. Clock and duration are unsigned 16-bit tick counts.
PL_DL_INIT:
PL_DL_PREVIOUS=PL_DL_NOW
PL_DL_LEFT=0 : PL_DL_ACTIVE=0 : PL_DL_EXPIRED=0 : PL_DL_ELAPSED=0
Return
PL_DL_START:
PL_DL_LEFT=PL_DL_DURATION : PL_DL_ACTIVE=0 : PL_DL_EXPIRED=0
If PL_DL_DURATION>0
   PL_DL_ACTIVE=1
End If
Return
PL_DL_POLL:
PL_DL_EXPIRED=0
PL_DL_ELAPSED=PL_DL_NOW-PL_DL_PREVIOUS
If PL_DL_ELAPSED<0
   PL_DL_ELAPSED=PL_DL_ELAPSED+65536
End If
PL_DL_PREVIOUS=PL_DL_NOW
If PL_DL_ACTIVE=0
   Return
End If
PL_DL_LEFT=PL_DL_LEFT-PL_DL_ELAPSED
If PL_DL_LEFT<=0
   PL_DL_LEFT=0 : PL_DL_ACTIVE=0 : PL_DL_EXPIRED=1
End If
Return
