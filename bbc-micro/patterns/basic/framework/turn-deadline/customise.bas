40 ? (MB%+16)=165:? (MB%+17)=90
50 GOSUB 8000
100 GOSUB 5000
110 K$=INKEY$(0)
130 IF DX% THEN EX%=EX%+1:IF EX%>255 THEN EX%=0
140 IF DX% THEN GOSUB 1000:GOSUB 3100:GOSUB 8000:GOTO 100
145 IF K$="Q" THEN END
150 IF K$="T" THEN GOSUB 6000:GOSUB 8000:GOTO 100
160 IF K$<>" " THEN GOTO 190
170 GOSUB 1000
180 IF DA% THEN GOSUB 3100
185 GOSUB 8000
190 GOSUB 9000:GOTO 100
6000 IF DA% THEN DA%=0:DR%=0:RETURN
6010 GOSUB 3100:RETURN
8000 PRINT TAB(0,0);:PRINT "SPACE:TURN T:TIMER Q:QUIT"
8010 PRINT "TURN";N%;" EX";EX%;" TIMER";DA%;"   "
8020 RETURN
