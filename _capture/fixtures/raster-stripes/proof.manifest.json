  "controls": [
    {
      "id": "mistimed-128k",
      "program": "stripes-mistimed.asm",
      "must_fail_on": [
        "spectrum_128k",
        "spectrum_plus2a"
      ],
      "why": "The 128K family's 228 T-state lines get the 48K's 224 T-state loop, so its stripes slant; the 48K and Pentagon are untouched."
    },
    {
      "id": "harmless-padding",
      "program": "stripes-padded.asm",
      "must_fail_on": [],
      "why": "64 extra bytes change the tape's loading time, and so the phase the program starts in, but not the effect: it must pass on every model."
    }
